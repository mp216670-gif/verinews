# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///./news_auth.db

# PostgreSQL (required on Vercel; do not use SQLite in serverless production):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/verinews

# ── Security ──────────────────────────────────────────────────────────────
# IMPORTANT: Replace this with a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=local-development-only-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Never seed demo credentials in production.
SEED_DEMO_DATA=true

# Required for a new production deployment. Configure these as Vercel secrets.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# ── External APIs (Optional) ──────────────────────────────────────────────
# Google Fact Check Tools API — optional external fallback verifier
# Get a free key at: https://developers.google.com/fact-check/tools/api
FACT_CHECK_API_KEY=
